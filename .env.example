# Docker daemon. Prefer the socket on the same host as this app.
# In Compose, nsenter into PID 1 exposes the host socket at this path — no bind-mount needed.
DOCKER_SOCKET=/var/run/docker.sock
# Alternative to DOCKER_SOCKET (unix:// or tcp://). dockerode also reads this.
# DOCKER_HOST=unix:///var/run/docker.sock

# Optional highlight in the UI. Not required for Compose: after nsenter, every
# local volume is read from /var/lib/docker/volumes/<name>/_data.
# VOLUME_BIND=dvm-workspace

# Filesystem path where VOLUME_BIND is mounted inside the app process.
# Optional. Compose no longer bind-mounts a workspace volume.
# For local `bun run dev`, leave unset to browse via a helper container,
# or point at a folder you want to edit.
# VOLUME_PATH=/mnt/volume

# Directory that contains named volume data dirs (each with a `_data` folder).
# Override if the engine uses a custom data-root or rootless Docker.
# DOCKER_VOLUMES_DIR=/var/lib/docker/volumes

# Image used to browse volumes when the host Docker data dir is not visible
# (typical for local `bun run dev` without nsenter).
# DVM_HELPER_IMAGE=alpine:3.21
