# Docker daemon. Prefer the socket on the same host as this app.
DOCKER_SOCKET=/var/run/docker.sock
# Alternative to DOCKER_SOCKET (unix:// or tcp://). dockerode also reads this.
# DOCKER_HOST=unix:///var/run/docker.sock

# Named volume the UI treats as bound for file browsing.
# In Compose this is also the volume mounted at VOLUME_PATH.
VOLUME_BIND=dvm-workspace

# Filesystem path where VOLUME_BIND is mounted inside the app process.
# Compose sets this to /mnt/volume. For local `bun run dev`, leave unset
# to browse via a helper container, or point at a folder you want to edit.
# VOLUME_PATH=/mnt/volume

# Image used to browse volumes that are not bind-mounted into the app.
# DVM_HELPER_IMAGE=alpine:3.21
